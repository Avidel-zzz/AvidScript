{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avidscript.dev/schemas/phase-state-v1.json",
  "title": "AvidScript Phase State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "declared_stage",
    "architecture",
    "documents",
    "batches",
    "debt",
    "review",
    "budgets",
    "invocations",
    "freeze",
    "gate",
    "protected_dirty",
    "next_action",
    "revision",
    "updated_at_utc"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goal", "start_commit"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "start_commit": { "$ref": "#/$defs/gitHash" }
      }
    },
    "declared_stage": {
      "enum": ["implementing", "gate_ready", "gate_attested"]
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256", "revision_reason"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "revision_reason": { "type": "string", "maxLength": 4096 }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "closeout"],
      "properties": {
        "plan": { "$ref": "#/$defs/repositoryPath" },
        "closeout": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence", "completed_at_utc"],
        "properties": {
          "id": { "$ref": "#/$defs/itemId" },
          "status": { "enum": ["Pending", "Completed"] },
          "evidence": { "type": "string", "maxLength": 8192 },
          "completed_at_utc": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "debt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "found_batch",
          "scope",
          "evidence",
          "deferral_reason",
          "remediation",
          "status",
          "resolution_evidence",
          "target_phase",
          "transfer_reason"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/itemId" },
          "severity": { "enum": ["Blocker", "Critical", "Important", "Normal"] },
          "found_batch": { "$ref": "#/$defs/itemId" },
          "scope": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "deferral_reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "remediation": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "status": { "enum": ["Open", "Fixing", "Verified", "Transferred"] },
          "resolution_evidence": { "type": "string", "maxLength": 8192 },
          "target_phase": { "type": ["integer", "null"], "minimum": 1, "maximum": 9999 },
          "transfer_reason": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "evidence", "completed_at_utc"],
      "properties": {
        "completed": { "type": "boolean" },
        "evidence": { "type": "string", "maxLength": 8192 },
        "completed_at_utc": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "budgets": { "$ref": "#/$defs/counters" },
    "invocations": { "$ref": "#/$defs/counters" },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "source_tree", "state_sha256", "review_evidence", "at_utc"],
      "properties": {
        "source_commit": { "oneOf": [{ "$ref": "#/$defs/gitHash" }, { "type": "string", "maxLength": 0 }] },
        "source_tree": { "oneOf": [{ "$ref": "#/$defs/gitHash" }, { "type": "string", "maxLength": 0 }] },
        "state_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "string", "maxLength": 0 }] },
        "review_evidence": { "type": "string", "maxLength": 8192 },
        "at_utc": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_path",
        "report_sha256",
        "run_id",
        "verified_commit",
        "verified_tree",
        "attestation_parent",
        "attested_at_utc"
      ],
      "properties": {
        "report_path": { "type": "string", "maxLength": 32768 },
        "report_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "string", "maxLength": 0 }] },
        "run_id": { "type": "string", "maxLength": 256 },
        "verified_commit": { "oneOf": [{ "$ref": "#/$defs/gitHash" }, { "type": "string", "maxLength": 0 }] },
        "verified_tree": { "oneOf": [{ "$ref": "#/$defs/gitHash" }, { "type": "string", "maxLength": 0 }] },
        "attestation_parent": { "oneOf": [{ "$ref": "#/$defs/gitHash" }, { "type": "string", "maxLength": 0 }] },
        "attested_at_utc": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "protected_dirty": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "worktree_sha256", "head_blob_sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/repositoryPath" },
          "status": { "type": "string", "minLength": 2, "maxLength": 2 },
          "worktree_sha256": { "$ref": "#/$defs/sha256" },
          "head_blob_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "string", "maxLength": 0 }] }
        }
      }
    },
    "next_action": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at_utc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "gitHash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "itemId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ubt", "automation", "full_gate"],
      "properties": {
        "ubt": { "type": "integer", "minimum": 0 },
        "automation": { "type": "integer", "minimum": 0 },
        "full_gate": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
