{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avidscript.dev/schemas/compatibility-report-v1.json",
  "title": "AvidScript Compatibility Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "result",
    "generated_at_utc",
    "context",
    "identity",
    "summary",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "format": { "const": "avidscript.compatibility.report" },
    "result": { "enum": ["ready", "degraded", "blocked"] },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_root", "project_root", "engine_root"],
      "properties": {
        "plugin_root": { "type": "string" },
        "project_root": { "type": "string" },
        "engine_root": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_version",
        "engine_version",
        "dotnet_sdk",
        "powershell",
        "install_release_id",
        "binding_package_sha256",
        "generated_type_package_id",
        "wasmtime_toolchain_id"
      ],
      "properties": {
        "plugin_version": { "type": "string" },
        "engine_version": { "type": "string" },
        "dotnet_sdk": { "type": "string" },
        "powershell": { "type": "string" },
        "install_release_id": { "type": "string" },
        "binding_package_sha256": { "type": "string" },
        "generated_type_package_id": { "type": "string" },
        "wasmtime_toolchain_id": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "warning", "blocked", "not_run", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "status",
          "severity",
          "code",
          "category",
          "expected",
          "actual",
          "message",
          "remediation"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "area": { "enum": ["host", "plugin", "project", "platform"] },
          "status": { "enum": ["passed", "warning", "blocked", "not_run"] },
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string", "pattern": "^ASCD[0-9]{4}$" },
          "category": {
            "enum": ["compatible", "degraded", "incompatible", "not_run"]
          },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "message": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string" }
        }
      }
    }
  }
}
