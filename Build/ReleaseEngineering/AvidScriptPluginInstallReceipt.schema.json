{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avidscript.dev/schemas/plugin-install-receipt-v1.json",
  "title": "AvidScript Plugin Install Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "release_id",
    "version",
    "manifest_sha256",
    "inventory_sha256",
    "source_commit",
    "source_tree",
    "installed_at_utc",
    "files"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "format": { "const": "avidscript.plugin.install" },
    "release_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inventory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "installed_at_utc": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "length", "sha256", "role"],
        "properties": {
          "path": { "type": "string" },
          "length": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": {
            "enum": [
              "metadata",
              "native_source",
              "managed_source",
              "third_party",
              "tooling",
              "content",
              "documentation"
            ]
          }
        }
      }
    }
  }
}
