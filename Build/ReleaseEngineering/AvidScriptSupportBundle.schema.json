{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avidscript.dev/schemas/support-bundle-v1.json",
  "title": "AvidScript Support Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "bundle_id",
    "generated_at_utc",
    "compatibility",
    "limits",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "format": { "const": "avidscript.support.bundle" },
    "bundle_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "result", "check_count"],
      "properties": {
        "format": { "const": "avidscript.compatibility.report" },
        "result": { "enum": ["ready", "degraded", "blocked"] },
        "check_count": { "type": "integer", "minimum": 1 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_logs", "maximum_log_bytes", "maximum_log_lines"],
      "properties": {
        "maximum_logs": { "const": 8 },
        "maximum_log_bytes": { "const": 65536 },
        "maximum_log_lines": { "const": 200 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "inventory_sha256", "file_count", "total_bytes", "files"],
      "properties": {
        "root": { "const": "files" },
        "inventory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "file_count": { "type": "integer", "minimum": 1, "maximum": 9 },
        "total_bytes": { "type": "integer", "minimum": 1, "maximum": 589824 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "length", "sha256", "role"],
            "properties": {
              "path": { "type": "string" },
              "length": { "type": "integer", "minimum": 0, "maximum": 65536 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "role": { "enum": ["metadata", "documentation"] }
            }
          }
        }
      }
    }
  }
}
