{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avidscript.dev/schemas/source-release-files-v1.json",
  "title": "AvidScript Source Release File Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "publisher_version",
    "include",
    "exclude",
    "generated",
    "targets",
    "contracts",
    "dependencies"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "const": "source-developer" },
    "publisher_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "include": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readme_source", "readme_destination"],
      "properties": {
        "readme_source": {
          "const": "Build/ReleaseEngineering/AvidScriptReleaseReadme.md"
        },
        "readme_destination": { "const": "README.md" }
      }
    },
    "targets": {
      "type": "array",
      "prefixItems": [
        { "const": "Android-arm64" },
        { "const": "Win64" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_abi",
        "binding_descriptor_max",
        "semantic_schema",
        "guest_ir_schema"
      ],
      "properties": {
        "module_abi": { "const": 1 },
        "binding_descriptor_max": { "const": 23 },
        "semantic_schema": { "const": 20 },
        "guest_ir_schema": { "const": 2 }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "identity_path"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "version": { "type": "string", "minLength": 1 },
          "identity_path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
