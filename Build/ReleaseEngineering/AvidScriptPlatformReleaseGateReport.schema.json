{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avidscript.dev/schemas/platform-release-gate-report-v1.json",
  "title": "AvidScript Platform Release Gate Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "run_id",
    "mode",
    "result",
    "report_file",
    "started_at_utc",
    "completed_at_utc",
    "identities",
    "summary",
    "layers"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "format": { "const": "avidscript.platform.release-gate" },
    "run_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "mode": { "enum": ["Inspect", "Execute"] },
    "result": { "enum": ["passed", "partial", "failed"] },
    "report_file": { "type": "string", "pattern": "^Saved/AvidScript/ReleaseGate/.+\\.json$" },
    "started_at_utc": { "type": "string", "format": "date-time" },
    "completed_at_utc": { "type": "string", "format": "date-time" },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "release_manifest_sha256",
        "source_commit",
        "source_tree",
        "generated_type_package_id",
        "runtime_package_id",
        "module_catalog_sha256",
        "module_variants"
      ],
      "properties": {
        "release_id": { "type": "string", "pattern": "^(|[0-9a-f]{64})$" },
        "release_manifest_sha256": { "type": "string", "pattern": "^(|[0-9a-f]{64})$" },
        "source_commit": { "type": "string", "pattern": "^(|[0-9a-f]{40})$" },
        "source_tree": { "type": "string", "pattern": "^(|[0-9a-f]{40})$" },
        "generated_type_package_id": { "type": "string", "pattern": "^(|[0-9a-f]{64})$" },
        "runtime_package_id": { "type": "string", "pattern": "^(|[0-9a-f]{64})$" },
        "module_catalog_sha256": { "type": "string", "pattern": "^(|[0-9a-f]{64})$" },
        "module_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module_id", "platform", "architecture", "configuration", "backend", "package_id", "descriptor_sha256"],
            "properties": {
              "module_id": { "type": "string" },
              "platform": { "enum": ["android", "win64"] },
              "architecture": { "enum": ["arm64", "x86_64"] },
              "configuration": { "enum": ["development", "shipping"] },
              "backend": { "const": "wasmtime" },
              "package_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "descriptor_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "blocked", "not_run", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "total": { "const": 8 }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "status", "code", "message", "details"],
        "properties": {
          "id": {
            "enum": [
              "release-package",
              "project-artifacts",
              "win64-shipping",
              "android-toolchain",
              "android-arm64",
              "android-package",
              "android-device",
              "shipping-manual"
            ]
          },
          "platform": { "enum": ["shared", "Win64", "Android", "manual"] },
          "status": { "enum": ["passed", "failed", "blocked", "not_run"] },
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "message": { "type": "string" },
          "details": { "type": "object" }
        }
      }
    }
  }
}
