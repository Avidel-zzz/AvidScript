{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avidscript.dev/schema/phase65-packaged-benchmark-host-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_utc",
    "candidate_id",
    "candidate_manifest_sha256",
    "candidate_commit",
    "candidate_tree",
    "package_catalog_sha256",
    "configuration",
    "target",
    "uat_log_path",
    "uat_log_sha256",
    "archive_root",
    "archive_content_sha256",
    "archive_file_count",
    "executable_path",
    "executable_sha256",
    "runtime_executable_path",
    "runtime_executable_sha256",
    "pak_files"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "created_utc": { "type": "string", "format": "date-time" },
    "candidate_id": { "type": "string", "pattern": "^[0-9a-f]{20}$" },
    "candidate_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "candidate_commit": { "$ref": "#/$defs/sha1" },
    "candidate_tree": { "$ref": "#/$defs/sha1" },
    "package_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "configuration": { "const": "Development" },
    "target": { "type": "string", "minLength": 1 },
    "uat_log_path": { "type": "string", "minLength": 1 },
    "uat_log_sha256": { "$ref": "#/$defs/sha256" },
    "archive_root": { "type": "string", "minLength": 1 },
    "archive_content_sha256": { "$ref": "#/$defs/sha256" },
    "archive_file_count": { "type": "integer", "minimum": 1 },
    "executable_path": { "type": "string", "minLength": 1 },
    "executable_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_executable_path": { "type": "string", "minLength": 1 },
    "runtime_executable_sha256": { "$ref": "#/$defs/sha256" },
    "pak_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
