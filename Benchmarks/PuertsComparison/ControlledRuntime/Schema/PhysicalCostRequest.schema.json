{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_kind",
    "attempt_id",
    "profile_sha256",
    "candidate_commit",
    "candidate_tree_sha",
    "candidate_clean",
    "engine_executable_sha256",
    "process_run",
    "warmup_samples",
    "timed_samples",
    "iterations",
    "seed",
    "kernel_wasm_path",
    "kernel_wasm_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark_kind": { "const": "physical_crossing_cost_ladder" },
    "attempt_id": { "type": "string", "format": "uuid" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "candidate_commit": { "$ref": "#/$defs/commit" },
    "candidate_tree_sha": { "$ref": "#/$defs/commit" },
    "candidate_clean": { "const": true },
    "engine_executable_sha256": { "$ref": "#/$defs/sha256" },
    "process_run": { "type": "integer", "minimum": 0 },
    "warmup_samples": { "type": "integer", "minimum": 1, "maximum": 100 },
    "timed_samples": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "iterations": { "type": "integer", "minimum": 1, "maximum": 100000000 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "kernel_wasm_path": { "type": "string", "minLength": 1 },
    "kernel_wasm_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
