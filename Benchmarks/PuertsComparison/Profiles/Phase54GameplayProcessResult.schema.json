{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P54.6 raw per-process gameplay samples",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "process_run",
    "lane_order",
    "lane_catalog",
    "lane_catalog_sha256",
    "timer_frequency_hz",
    "provenance",
    "samples"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "process_run": { "type": "integer", "minimum": 0 },
    "lane_order": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "lane_catalog": { "type": "array", "minItems": 6, "maxItems": 6 },
    "lane_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "timer_frequency_hz": { "type": "integer", "minimum": 1 },
    "provenance": {
      "type": "object",
      "required": [
        "avidscript_commit",
        "avidscript_tree_sha",
        "avidscript_dirty",
        "profile_id",
        "profile_sha256",
        "lane_catalog_sha256",
        "wasm_sha256",
        "manifest_sha256"
      ],
      "properties": {
        "avidscript_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "avidscript_tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "avidscript_dirty": { "type": "boolean" },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "lane_catalog_sha256": { "$ref": "#/$defs/sha256" },
        "wasm_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sample": {
      "type": "object",
      "required": [
        "process_run",
        "lane",
        "lane_identity_sha256",
        "lane_position",
        "workload",
        "sample_index",
        "seed",
        "iterations",
        "elapsed_cycles",
        "checksum",
        "expected_checksum",
        "generated_s1_hit_count",
        "generated_s1_fallback_count",
        "generated_s1_reject_count",
        "data_lane_command_count",
        "data_lane_crossing_count",
        "data_lane_rejected_buffer_count",
        "semantic_hit_count",
        "logical_operation_count",
        "allocations",
        "peak_memory_bytes",
        "generated_code_size",
        "correct"
      ],
      "properties": {
        "process_run": { "type": "integer", "minimum": 0 },
        "lane": { "type": "string", "minLength": 1 },
        "lane_identity_sha256": { "$ref": "#/$defs/sha256" },
        "lane_position": { "type": "integer", "minimum": 0, "maximum": 5 },
        "workload": {
          "enum": ["gameplay_frame_small", "gameplay_frame_dense"]
        },
        "sample_index": { "type": "integer", "minimum": 0 },
        "seed": { "type": "integer" },
        "iterations": { "type": "integer", "minimum": 1 },
        "elapsed_cycles": { "type": "integer", "minimum": 1 },
        "checksum": { "type": "integer" },
        "expected_checksum": { "type": "integer" },
        "generated_s1_hit_count": { "type": "integer", "minimum": 0 },
        "generated_s1_fallback_count": { "type": "integer", "minimum": 0 },
        "generated_s1_reject_count": { "type": "integer", "minimum": 0 },
        "data_lane_command_count": { "type": "integer", "minimum": 0 },
        "data_lane_crossing_count": { "type": "integer", "minimum": 0 },
        "data_lane_rejected_buffer_count": { "type": "integer", "minimum": 0 },
        "semantic_hit_count": { "type": "integer", "minimum": 0 },
        "logical_operation_count": { "type": "integer", "minimum": 1 },
        "allocations": {
          "type": "object",
          "required": ["status", "count", "net_physical_bytes"]
        },
        "peak_memory_bytes": { "type": "integer", "minimum": 0 },
        "generated_code_size": {
          "type": "object",
          "required": ["status", "bytes"]
        },
        "correct": { "const": true }
      }
    }
  }
}
