{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvidScript 基准校准结果",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_id",
    "timer_frequency_hz",
    "lane_catalog",
    "lane_catalog_sha256",
    "provenance",
    "iteration_counts"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "calibration_id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "timer_frequency_hz": { "type": "integer", "minimum": 1 },
    "lane_catalog": { "$ref": "#/$defs/lane_catalog" },
    "lane_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ue_version",
        "ue_build_id",
        "editor_executable_sha256",
        "editor_file_version",
        "target",
        "configuration",
        "avidscript_commit",
        "puerts_commit",
        "puerts_backend_sha256",
        "null_rhi",
        "cpu",
        "os",
        "wamr_mode",
        "v8_mode",
        "wasm_sha256",
        "manifest_sha256",
        "avidscript_tree_sha",
        "avidscript_dirty",
        "allow_non_formal_profile",
        "profile_id",
        "profile_sha256",
        "request_schema_sha256",
        "calibration_schema_sha256",
        "result_schema_sha256",
        "aggregate_schema_sha256",
        "lane_catalog_sha256"
      ],
      "properties": {
        "ue_version": { "type": "string", "minLength": 1 },
        "ue_build_id": { "type": "string", "minLength": 1 },
        "editor_executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "editor_file_version": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1 },
        "avidscript_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "puerts_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "puerts_backend_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "null_rhi": { "type": "boolean" },
        "cpu": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "wamr_mode": { "type": "string", "minLength": 1 },
        "v8_mode": { "type": "string", "minLength": 1 },
        "wasm_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "avidscript_tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "avidscript_dirty": { "const": false },
        "allow_non_formal_profile": { "type": "boolean" },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "request_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "calibration_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "aggregate_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lane_catalog_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "iteration_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 5,
        "maxProperties": 5,
        "required": [
          "native_cpp",
          "puerts_v8_reflection",
          "puerts_v8_static",
          "avidscript_wasmtime_native_direct"
        ],
        "properties": {
          "native_cpp": { "type": "integer", "minimum": 1 },
          "puerts_v8_reflection": { "type": "integer", "minimum": 1 },
          "puerts_v8_static": { "type": "integer", "minimum": 1 },
          "avidscript_wasmtime_adaptive_semantic": { "type": "integer", "minimum": 1 },
          "avidscript_wasmtime_semantic": { "type": "integer", "minimum": 1 },
          "avidscript_wasmtime_native_direct": { "type": "integer", "minimum": 1 }
        },
        "oneOf": [
          { "required": ["avidscript_wasmtime_adaptive_semantic"] },
          { "required": ["avidscript_wasmtime_semantic"] }
        ]
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lane_id": {
      "enum": [
        "native_cpp",
        "puerts_v8_reflection",
        "puerts_v8_static",
        "avidscript_wasmtime_adaptive_semantic",
        "avidscript_wasmtime_semantic",
        "avidscript_wasmtime_native_direct"
      ]
    },
    "lane_catalog": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/lane_catalog_entry" }, { "properties": { "lane_id": { "const": "native_cpp" } } }] },
        { "allOf": [{ "$ref": "#/$defs/lane_catalog_entry" }, { "properties": { "lane_id": { "const": "puerts_v8_reflection" } } }] },
        { "allOf": [{ "$ref": "#/$defs/lane_catalog_entry" }, { "properties": { "lane_id": { "const": "puerts_v8_static" } } }] },
        {
          "allOf": [
            { "$ref": "#/$defs/lane_catalog_entry" },
            {
              "oneOf": [
                { "properties": { "lane_id": { "const": "avidscript_wasmtime_adaptive_semantic" }, "binding_invocation_mode": { "const": "adaptive_semantic" } } },
                { "properties": { "lane_id": { "const": "avidscript_wasmtime_semantic" }, "binding_invocation_mode": { "const": "semantic_process_event" } } }
              ]
            }
          ]
        },
        { "allOf": [{ "$ref": "#/$defs/lane_catalog_entry" }, { "properties": { "lane_id": { "const": "avidscript_wasmtime_native_direct" }, "binding_invocation_mode": { "const": "qualified_native_direct" } } }] }
      ],
      "items": false
    },
    "lane_catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id", "runtime_id", "runtime_version", "execution_tier", "adapter_id",
        "wasm_workload_kind", "source_wasm_sha256", "execution_artifact_format",
        "execution_artifact_sha256", "compiler_identity", "compiler_flags",
        "runtime_build_config", "runtime_build_identity", "runtime_artifact_sha256", "target_triple",
        "cpu_feature_policy", "backend_id", "binding_invocation_mode", "execution_mode", "fallback_used",
        "lane_identity_sha256"
      ],
      "properties": {
        "lane_id": { "$ref": "#/$defs/lane_id" },
        "runtime_id": { "type": "string", "minLength": 1 },
        "runtime_version": { "type": "string", "minLength": 1 },
        "execution_tier": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "wasm_workload_kind": { "enum": ["not_applicable", "fixed_equivalent_kernel", "csharp_frontend_output"] },
        "source_wasm_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "execution_artifact_format": { "type": "string", "minLength": 1 },
        "execution_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "compiler_identity": { "type": "string", "minLength": 1 },
        "compiler_flags": { "type": "array", "items": { "type": "string" } },
        "runtime_build_config": { "type": "string", "minLength": 1 },
        "runtime_build_identity": { "type": "string", "minLength": 1 },
        "runtime_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "target_triple": { "type": "string", "minLength": 1 },
        "cpu_feature_policy": { "type": "string", "minLength": 1 },
        "backend_id": { "type": ["string", "null"] },
        "binding_invocation_mode": { "enum": [null, "adaptive_semantic", "semantic_process_event", "qualified_native_direct"] },
        "execution_mode": { "type": "string", "minLength": 1 },
        "fallback_used": { "const": false },
        "lane_identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
