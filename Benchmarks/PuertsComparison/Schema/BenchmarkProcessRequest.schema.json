{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvidScript 单进程基准请求",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "attempt_id",
    "process_run",
    "lane_order",
    "lanes",
    "workloads",
    "warmup_samples",
    "timed_samples",
    "minimum_sample_milliseconds",
    "minimum_iterations",
    "maximum_iterations",
    "seed",
    "iteration_counts",
    "provenance",
    "result_schema",
    "result_path",
    "result_write"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["calibration", "timed"] },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "process_run": { "type": "integer", "minimum": -1 },
    "lane_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "native_cpp",
          "puerts_v8_reflection",
          "puerts_v8_static",
          "avidscript_wamr"
        ]
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "native_cpp",
          "puerts_v8_reflection",
          "puerts_v8_static",
          "avidscript_wamr"
        ]
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "warmup_samples": { "type": "integer", "minimum": 0 },
    "timed_samples": { "type": "integer", "minimum": 0 },
    "minimum_sample_milliseconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "minimum_iterations": { "type": "integer", "minimum": 1 },
    "maximum_iterations": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "iteration_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "native_cpp",
          "puerts_v8_reflection",
          "puerts_v8_static",
          "avidscript_wamr"
        ],
        "properties": {
          "native_cpp": { "type": "integer", "minimum": 1 },
          "puerts_v8_reflection": { "type": "integer", "minimum": 1 },
          "puerts_v8_static": { "type": "integer", "minimum": 1 },
          "avidscript_wamr": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ue_version",
        "ue_build_id",
        "target",
        "configuration",
        "avidscript_commit",
        "puerts_commit",
        "puerts_backend_sha256",
        "null_rhi",
        "cpu",
        "os",
        "wamr_mode",
        "v8_mode",
        "wasm_sha256",
        "manifest_sha256",
        "avidscript_tree_sha",
        "avidscript_dirty",
        "allow_non_formal_profile",
        "profile_id",
        "profile_sha256",
        "request_schema_sha256",
        "calibration_schema_sha256",
        "result_schema_sha256",
        "aggregate_schema_sha256"
      ],
      "properties": {
        "ue_version": { "type": "string", "minLength": 1 },
        "ue_build_id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1 },
        "avidscript_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "puerts_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "puerts_backend_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "null_rhi": { "type": "boolean" },
        "cpu": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "wamr_mode": { "type": "string", "minLength": 1 },
        "v8_mode": { "type": "string", "minLength": 1 },
        "wasm_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "avidscript_tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "avidscript_dirty": { "const": false },
        "allow_non_formal_profile": { "type": "boolean" },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "request_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "calibration_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "aggregate_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "result_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "const": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "result_path": { "type": "string", "minLength": 1 },
    "result_write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "temporary_path", "overwrite"],
      "properties": {
        "strategy": {
          "const": "same_directory_temporary_then_atomic_rename"
        },
        "temporary_path": { "type": "string", "minLength": 1 },
        "overwrite": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "calibration" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "process_run": { "const": -1 },
          "timed_samples": { "const": 0 },
          "iteration_counts": { "maxProperties": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "timed" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "process_run": { "minimum": 0 },
          "timed_samples": { "minimum": 1 },
          "iteration_counts": { "minProperties": 1 }
        }
      }
    }
  ]
}
